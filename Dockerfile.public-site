# Imagem do site público Lodout.
# A mesma imagem atende aos dois serviços (ver docker-compose.public-site.yml
# e lodout/public_site/README.md):
#   web    -> gunicorn servindo o dashboard + /conta (Fases 1/2)
#   worker -> processo solitário que fala com a Steam (worker.py)
#
# Multi-stage (2026-10-26): o Dockerfile de 1 estágio anterior fazia
# `COPY scripts/minify_static.py` + `RUN ... && rm -rf scripts` numa
# única imagem -- mas camadas Docker são aditivas, então o `rm -rf`
# cria uma camada NOVA que esconde o arquivo, sem removê-lo do tamanho
# final da imagem (o script e o cache de instalação do pip continuavam
# lá, só invisíveis no `ls`). Separar builder/final é o jeito correto:
# só os arquivos copiados explicitamente com `--from=builder` entram na
# imagem final.
#
# Build:  docker build -f Dockerfile.public-site -t lodout-public-site .
#
# Python 3.12 (2026-11-05, era 3.9): o Pillow 11.3.0 -- última versão da
# série 11.x -- tinha 73 CVEs sem patch retroativo, só corrigidas a
# partir do Pillow 12.1.1+, que exige Python >=3.10. 3.12 já era testado
# na CI (tests.yml), por isso o piso novo é esse, não 3.10/3.11 sem uso
# nenhum no projeto. Python 3.9 também já estava fora de suporte da
# própria PSF desde 2025-10 -- a troca resolve os dois problemas juntos.

FROM python:3.12-slim AS builder
WORKDIR /app

# Dependências runtime do site e do worker.
COPY requirements-public-site.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-public-site.txt

COPY lodout/ lodout/

# Minifica style.css/app.js dentro do builder -- o fonte no repositório
# continua legível em dev; só a cópia minificada segue pro estágio final.
COPY scripts/minify_static.py scripts/minify_static.py
RUN python scripts/minify_static.py lodout/public_site/static

FROM python:3.12-slim
WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /app/lodout lodout/

# Usuário sem privilégio (achado de auditoria, skill docker-security-
# guide, 2026-11-05: a imagem inteira rodava como root -- nenhum USER
# definido em lugar nenhum). UID/GID fixos (1000) pra ficarem estáveis
# entre rebuilds; `--no-create-home`/`--shell nologin` porque este
# usuário nunca faz login interativo, só roda o processo do container.
# O ajuste de posse de /data (volume de produção com dado real,
# possivelmente root:root de antes desta mudança) fica no
# entrypoint.sh, não aqui -- em build-time o volume ainda nem existe.
RUN groupadd --gid 1000 lodout && \
    useradd --uid 1000 --gid lodout --no-create-home \
            --shell /usr/sbin/nologin lodout

# DATA_DIR de verdade vem de um volume montado aqui (SQLite + os JSON
# globais do dashboard tem que sobreviver a redeploy -- ver _paths.py).
ENV LODOUT_DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 8000

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

# Identificador do build (data/hora UTC), não um hash de git -- mais
# simples de obter aqui dentro sem precisar copiar o `.git` todo pra
# imagem. Lido por server.py pra mostrar "v1.0.0 (build ...)" no rodapé,
# em vez de um número fixo que nunca muda entre deploys.
#
# DE PROPÓSITO a ÚLTIMA instrução antes do CMD (achado 2026-11-06): o
# cache de camada do Docker reaproveita uma RUN sempre que nem o
# comando nem as camadas ANTERIORES mudaram -- com isto lá em cima
# (antes do usuário/entrypoint), um deploy que só mudava camadas
# posteriores ficava com o timestamp velho, escondendo que o rebuild
# tinha de fato acontecido. Por último, QUALQUER mudança no Dockerfile
# -- não só em código -- invalida o cache até aqui e gera data nova.
RUN date -u +%Y%m%d-%H%M%S > BUILD_ID

# Shell form (nao exec form) de proposito: $PORT e' quem muitos provedores
# (Render/Railway/Fly.io) usam pra dizer em que porta escutar -- shell form
# expande a variavel; exec form nao. O ENTRYPOINT acima recebe isto (ou o
# `command:` do serviço "worker" no compose, que troca o CMD mas nunca o
# ENTRYPOINT) como argumentos e cede pro usuário sem privilégio.
CMD gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 2 lodout.public_site.wsgi:app
