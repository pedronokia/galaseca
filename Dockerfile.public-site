# Imagem do SITE PÚBLICO (skinvault/public_site/) -- não do app desktop.
#
# Duas imagens, dois usos, da MESMA imagem (ver docker-compose.public-site.yml
# e skinvault/public_site/README.md):
#   web    -> gunicorn servindo o dashboard + /conta (Fases 1/2)
#   worker -> processo solitário que fala com a Steam (worker.py)
#
# Build:  docker build -f Dockerfile.public-site -t skinvault-public-site .
FROM python:3.9-slim

WORKDIR /app

# So' as dependencias do site (Flask/httpx/gunicorn) -- NUNCA PyQt6/
# pywebview/etc. (essas sao do app desktop; ver requirements-public-site.txt).
COPY requirements-public-site.txt .
RUN pip install --no-cache-dir -r requirements-public-site.txt

COPY skinvault/ skinvault/

# DATA_DIR de verdade vem de um volume montado aqui (SQLite + os JSON
# globais do dashboard tem que sobreviver a redeploy -- ver _paths.py).
ENV SKINVAULT_DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 8000

# Shell form (nao exec form) de proposito: $PORT e' quem muitos provedores
# (Render/Railway/Fly.io) usam pra dizer em que porta escutar -- shell form
# expande a variavel; exec form nao.
CMD gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 2 skinvault.public_site.wsgi:app
