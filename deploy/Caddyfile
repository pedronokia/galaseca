{$SITE_DOMAIN} {
	encode gzip zstd

	# HSTS + CSP (pedido explícito do usuário, 2026-10-25). CSP exige que
	# o único <script> externo (static/app.js) e o JSON-LD inline sejam
	# os únicos pontos de execução -- por isso nada de 'unsafe-inline' em
	# script-src. O JSON-LD (type="application/ld+json") não é afetado
	# por script-src: é dado estruturado, não script executável, isento
	# por especificação do próprio CSP.
	#
	# `report-uri` (2a rodada, mesmo dia): sem isso, uma violação de
	# política só aparece se um visitante abrir o DevTools e reclamar --
	# com isso, o navegador reporta sozinho pro /api/csp-report, que cai
	# no mesmo errors.log que o /admin já mostra. Diretiva legada mas
	# ainda amplamente suportada (mais que a `report-to`/Reporting API,
	# que o Chrome removeu o suporte).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' https://community.cloudflare.steamstatic.com data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; report-uri /api/csp-report"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy web:8000
}
