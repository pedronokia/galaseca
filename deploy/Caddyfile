# Cabeçalhos de segurança e proxy do site (snippet: o www só redireciona).
(site) {
	encode gzip zstd

	# HSTS + CSP (pedido explícito do usuário, 2026-10-25). CSP exige que
	# o único <script> externo (static/app.js) e o JSON-LD inline sejam
	# os únicos pontos de execução -- por isso nada de 'unsafe-inline' em
	# script-src. O JSON-LD (type="application/ld+json") não é afetado
	# por script-src: é dado estruturado, não script executável, isento
	# por especificação do próprio CSP.
	#
	# `report-uri` (2a rodada, mesmo dia): sem isso, uma violação de
	# política só aparece se um visitante abrir o DevTools e reclamar --
	# com isso, o navegador reporta sozinho pro /api/csp-report, que cai
	# no mesmo errors.log que o /admin já mostra. Diretiva legada mas
	# ainda amplamente suportada (mais que a `report-to`/Reporting API,
	# que o Chrome removeu o suporte).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# object-src/base-uri/form-action (2a rodada, 2026-10-26): reforço
		# de profundidade -- nenhum deles muda comportamento real do site
		# (não usamos <object>, não trocamos <base>, todo form já
		# submete pra rota própria), só fecham brechas que um XSS
		# hipotético poderia explorar mesmo com o resto da CSP no lugar.
		Content-Security-Policy "default-src 'self'; img-src 'self' https://community.cloudflare.steamstatic.com data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Reforço do CSP frame-ancestors acima: navegador muito antigo que
		# não suporta CSP level 2 ainda respeita X-Frame-Options.
		X-Frame-Options "SAMEORIGIN"
		# O site não usa câmera/microfone/geolocalização/etc. em lugar
		# nenhum -- negar tudo é defesa em profundidade sem custo.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	}

	reverse_proxy web:8000
}

# Domínio principal desde 2026-10-29.
galaseca.com {
	import site
}

www.galaseca.com {
	redir https://galaseca.com{uri} permanent
}
